generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  DONOR
  PATIENT
  HOSPITAL
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
}

enum DonationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
  CANCELLED
}

enum Urgency {
  NORMAL
  URGENT
  EMERGENCY
}

enum AuditAction {
  DONATION_VERIFIED
  DONATION_REJECTED
  REQUEST_APPROVED
  REQUEST_REJECTED
  REQUEST_FULFILLED
  STOCK_ADJUSTED
  USER_ACTIVATED
  USER_DEACTIVATED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_COMPLETED
  STOCK_RESERVED
}

enum CenterType {
  BLOOD_BANK
  HOSPITAL
}

model User {
  id               String         @id @default(cuid())
  name             String
  email            String         @unique
  passwordHash     String
  phone            String
  role             Role
  city             String
  address          String?
  organizationName String?
  centerId         Int?
  center           BloodCenter?   @relation(fields: [centerId], references: [id])
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  donorProfile      DonorProfile?
  donations         Donation[]
  bloodRequests     BloodRequest[]
  notifications     Notification[]
  auditLogs         AuditLog[]         @relation("AdminAuditLogs")
  appointments      Appointment[]      @relation("UserAppointments")
  hospitalResponses HospitalResponse[] @relation("StaffResponses")
  stockHistory      StockHistory[]     @relation("UserStockHistory")
}

model DonorProfile {
  id                  String                @id @default(cuid())
  userId              String                @unique
  user                User                  @relation(fields: [userId], references: [id])
  bloodGroup          BloodGroup
  availabilityStatus  AvailabilityStatus    @default(AVAILABLE)
  notificationConsent Boolean               @default(true)
  allowNearbyAlerts   Boolean               @default(true)
  preferredRadiusKm   Int                   @default(25)
  lastDonationDate    DateTime?
  donationCount       Int                   @default(0)
  latitude            Float?
  longitude           Float?
  updatedAt           DateTime              @default(now()) @updatedAt
  emergencyAlerts     DonorEmergencyAlert[]
}

model BloodCenter {
  id                 Int                @id @default(autoincrement())
  name               String
  type               CenterType
  city               String
  state              String             @default("Madhya Pradesh")
  country            String             @default("India")
  address            String
  phone              String
  facilityType       String             @default("HOSPITAL_WITH_BLOOD_BANK")
  verificationStatus String             @default("VERIFIED")
  components         String?            @default("Whole Blood, PRBC, Platelets, FFP")
  dataSource         String             @default("National Blood Registry")
  popularRank        Int                @default(100)
  lastStockUpdate    DateTime?          @default(now())
  isMain             Boolean            @default(false)
  isActive           Boolean            @default(true)
  latitude           Float?
  longitude          Float?
  pincode            String?
  email              String?
  operatingHours     String?            @default("24x7 / Emergency Services")
  dailyCapacity      Int                @default(30)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  stocks             BloodStock[]
  users              User[]
  appointments       Appointment[]
  emergencyResponses HospitalResponse[]
  assignedRequests   BloodRequest[]     @relation("AssignedCenterRequests")
  stockHistory       StockHistory[]
  slotConfigs        CenterSlotConfig[]
}

model BloodStock {
  id            String      @id @default(cuid())
  centerId      Int
  center        BloodCenter @relation(fields: [centerId], references: [id])
  bloodGroup    BloodGroup
  component     String      @default("Whole Blood")
  units         Int         @default(0)
  reservedUnits Int         @default(0)
  lastUpdated   DateTime    @updatedAt

  @@unique([centerId, bloodGroup])
}

model StockHistory {
  id            String      @id @default(cuid())
  centerId      Int
  center        BloodCenter @relation(fields: [centerId], references: [id])
  bloodGroup    BloodGroup
  component     String      @default("Whole Blood")
  changeType    String
  unitsDelta    Int
  previousUnits Int
  newUnits      Int
  performedById String?
  performedBy   User?       @relation("UserStockHistory", fields: [performedById], references: [id])
  reason        String?
  referenceId   String?
  createdAt     DateTime    @default(now())

  @@index([centerId])
  @@index([bloodGroup])
  @@index([createdAt])
}

model Donation {
  id              String         @id @default(cuid())
  donorId         String
  donor           User           @relation(fields: [donorId], references: [id])
  bloodGroup      BloodGroup
  component       String         @default("Whole Blood")
  units           Int            @default(1)
  donationDate    DateTime
  location        String?
  status          DonationStatus @default(PENDING)
  rejectionReason String?
  verifiedAt      DateTime?
  createdAt       DateTime       @default(now())
}

model BloodRequest {
  id               String                 @id @default(cuid())
  requestCode      String?                @unique
  requesterId      String
  requester        User                   @relation(fields: [requesterId], references: [id])
  requesterName    String?
  patientName      String
  bloodGroup       BloodGroup
  component        String                 @default("Whole Blood")
  unitsRequired    Int
  reservedUnits    Int                    @default(0)
  hospitalName     String
  hospitalAddress  String?
  city             String
  state            String                 @default("Madhya Pradesh")
  contactNumber    String
  requiredDate     DateTime
  urgency          Urgency                @default(NORMAL)
  additionalInfo   String?
  status           RequestStatus          @default(PENDING)
  trackingStatus   String                 @default("SUBMITTED")
  rejectionReason  String?
  assignedCenterId Int?
  assignedCenter   BloodCenter?           @relation("AssignedCenterRequests", fields: [assignedCenterId], references: [id])
  requestDate      DateTime               @default(now())
  approvedAt       DateTime?
  fulfilledAt      DateTime?

  timeline          RequestTimelineEvent[]
  hospitalResponses HospitalResponse[]
  donorAlerts       DonorEmergencyAlert[]

  @@index([trackingStatus])
  @@index([city])
  @@index([bloodGroup])
}

model RequestTimelineEvent {
  id          String       @id @default(cuid())
  requestId   String
  request     BloodRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  status      String
  title       String
  description String
  performedBy String?
  createdAt   DateTime     @default(now())

  @@index([requestId])
  @@index([createdAt])
}

model HospitalResponse {
  id             String       @id @default(cuid())
  requestId      String
  request        BloodRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  centerId       Int
  center         BloodCenter  @relation(fields: [centerId], references: [id])
  staffUserId    String
  staffUser      User         @relation("StaffResponses", fields: [staffUserId], references: [id])
  responseType   String
  confirmedUnits Int?
  notes          String?
  createdAt      DateTime     @default(now())

  @@index([requestId])
  @@index([centerId])
}

model DonorEmergencyAlert {
  id             String       @id @default(cuid())
  requestId      String
  request        BloodRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  donorProfileId String
  donorProfile   DonorProfile @relation(fields: [donorProfileId], references: [id])
  status         String       @default("SENT")
  distanceKm     Float?
  notes          String?
  respondedAt    DateTime?
  createdAt      DateTime     @default(now())

  @@index([requestId])
  @@index([donorProfileId])
}

model Appointment {
  id                 String       @id @default(cuid())
  donorId            String
  donor              User         @relation("UserAppointments", fields: [donorId], references: [id])
  centerId           Int
  center             BloodCenter  @relation(fields: [centerId], references: [id])
  appointmentDate    DateTime
  timeSlot           String
  bloodGroup         BloodGroup
  component          String       @default("Whole Blood")
  status             String       @default("BOOKED")
  notes              String?
  cancellationReason String?
  attendanceMarked   Boolean      @default(false)
  completedAt        DateTime?
  donationId         String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([centerId, appointmentDate])
  @@index([donorId])
}

model CenterSlotConfig {
  id          String      @id @default(cuid())
  centerId    Int
  center      BloodCenter @relation(fields: [centerId], references: [id])
  dayOfWeek   Int
  timeSlot    String
  maxCapacity Int         @default(5)
  isActive    Boolean     @default(true)

  @@unique([centerId, dayOfWeek, timeSlot])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  type      String
  message   String
  metadata  Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id         String      @id @default(cuid())
  adminId    String
  admin      User        @relation("AdminAuditLogs", fields: [adminId], references: [id])
  action     AuditAction
  targetId   String
  targetType String
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}
