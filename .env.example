# ==========================================
# LifePulse BMS - Environment Variables
# ==========================================

# 1. DATABASE CONFIGURATION
# Local Development (SQLite):
DATABASE_URL="file:./dev.db"

# Production Cloud Deployment (PostgreSQL via Neon / Supabase / Render):
# DATABASE_URL="postgresql://username:password@ep-xyz.region.neon.tech/neondb?sslmode=require"

# 2. NEXTAUTH SECRET
# Used to encrypt and sign JWT session tokens (generate using `openssl rand -base64 32`)
NEXTAUTH_SECRET="bms-super-secret-jwt-key-for-blood-bank-system-2026"

# 3. BASE PUBLIC URL
# In local development:
NEXTAUTH_URL="http://localhost:3000"
# In production on Vercel / custom domain (uncomment and replace with your live URL):
# NEXTAUTH_URL="https://your-domain.vercel.app"
